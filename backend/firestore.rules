rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.role in [
                'super', 'super admin', 'superadmin', 'super_admin', 'admin', 'staff',
                'Super', 'Super Admin', 'SuperAdmin', 'Admin', 'Staff'
              ];
    }

    // Classroom Configuration
    match /classrooms/{classId} {
      // ESP32 and app users can read the list of classes
      allow read: if true;
      // Only authenticated staff/admins can write classrooms
      allow write: if isStaff();
    }

    // Announcement Collection
    match /announcements/{announcementId} {
      // Anyone (including ESP32 Gateway/Worker) can read announcements
      allow read: if true;
      // Only authenticated admins/staff can write announcements
      allow write: if isStaff();
      
      // Classroom Acknowledgements Subcollection
      match /acknowledgements/{classId} {
        // Workers/Gateway nodes write delivery receipts
        allow read, write: if true;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /departments/{departmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /radio_programmes/{programmeId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /student_queries/{queryId} {
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid;
      allow read: if isStaff() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow update, delete: if isStaff();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isStaff());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isStaff());
      allow delete: if isStaff();
    }
  }
}
