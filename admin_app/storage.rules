rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isStaff() {
      return signedIn() && firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data.role in ['super', 'super admin', 'superadmin', 'admin', 'staff', 'Super', 'Super Admin', 'SuperAdmin', 'Admin', 'Staff'];
    }

    match /announcements/{fileName} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff()
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
