// Access rules for the Campus Radio application.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.role in [
                'super', 'super admin', 'superadmin', 'super_admin', 'admin', 'staff',
                'Super', 'Super Admin', 'SuperAdmin', 'Admin', 'Staff'
              ];
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /departments/{departmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /radio_programmes/{programmeId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /student_queries/{queryId} {
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid;
      allow read: if isStaff() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow update, delete: if isStaff();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isStaff());
      allow create, update, delete: if isStaff();
    }
  }
}
